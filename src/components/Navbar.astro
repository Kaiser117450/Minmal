---

<header class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-[#e5e5e5]">
  <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-7 h-7 bg-[#111111] flex items-center justify-center text-white text-xs font-bold font-mono tracking-tight"
           style="border-radius: 0px;">
        MI
      </div>
      <span class="text-sm font-medium text-[#707072] group-hover:text-[#111111] transition-colors">
        Minal
      </span>
    </a>

    <!-- Nav links -->
    <nav class="hidden sm:flex items-center gap-1">
      <a href="#about" class="nav-link">About</a>
      <a href="#capabilities" class="nav-link">Capabilities</a>
      <a href="#values" class="nav-link">Values</a>
      <a href="#contact" class="nav-link">Contact</a>
    </nav>

    <!-- Status -->
    <div class="flex items-center gap-2">
      <span class="status-dot"></span>
      <span class="text-[11px] tracking-wide uppercase text-[#9e9ea0] font-medium hidden sm:inline">Online</span>
    </div>
  </div>
</header>

<style>
  .nav-link {
    padding: 6px 12px;
    border-radius: 0px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #707072;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: #111111;
  }
</style>