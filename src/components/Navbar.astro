---
---

<header class="fixed top-0 left-0 right-0 z-50" style="background: rgba(31,22,51,0.92); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--border);">
  <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-7 h-7 flex items-center justify-center text-white text-xs font-semibold"
           style="background: #150f23; border-radius: 6px; border: 1px solid var(--border);">
        M<span style="color: #c2ef4e;">I</span>
      </div>
      <span class="text-sm font-medium group-hover:text-white transition-colors" style="color: var(--text-secondary);">
        Minal
      </span>
    </a>

    <!-- Nav links -->
    <nav class="hidden sm:flex items-center gap-1">
      <a href="#about" class="nav-link">About</a>
      <a href="#capabilities" class="nav-link">Capabilities</a>
      <a href="#values" class="nav-link">Values</a>
      <a href="#contact" class="nav-link">Contact</a>
    </nav>

    <!-- Status -->
    <div class="flex items-center gap-2">
      <span class="status-dot"></span>
      <span class="text-[11px] tracking-[0.2px] font-semibold hidden sm:inline" style="color: var(--text-secondary);">Online</span>
    </div>
  </div>
</header>

<style>
  .nav-link {
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 16px;
    font-weight: 500;
    font-family: 'Rubik', system-ui, sans-serif;
    letter-spacing: 0;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .nav-link:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
  }
</style>
